"NSCalendarsWriteOnlyAccessUsageDescription" = "கேலெண்டரில் சேர் என்பதை அழுத்தும்போது Mail Dot ஒரு செய்தியிலுள்ள கூட்டத்தை உங்கள் கேலெண்டரில் சேர்க்கும். அது உங்கள் கேலெண்டரை ஒருபோதும் படிக்காது.";
"NSAudioCaptureUsageDescription" = "Mail Dot, Dot-க்கான தனது குரல் கோரிக்கையை அழைப்பில் அமைதியாக இயக்கும். அது தன் ஒலியை மட்டுமே பதிவு செய்யும், மற்ற ஆப்களையோ மைக்ரோஃபோனையோ அல்ல.";
"NSAppleEventsUsageDescription" = "நீங்கள் அனுமதிக்கும் கணக்குகளையும் கோப்புறைகளையும் மட்டுமே Mail Dot படிக்கும், நீங்கள் வெளிப்படையாகப் பகிரும் பதில்களை இணைக்கும், உங்கள் ஒப்புதலுக்குப் பின் சரிபார்த்த வரைவுகளைப் பயன்படுத்தும் அல்லது அனுப்பும்.";
